# AMD GPU image: PyTorch ROCm + transformers Whisper (use `--engine transformers`).
# The ROCm user-space libraries ship inside the PyTorch wheels, so the host only needs the
# `amdgpu` kernel driver (/dev/kfd and /dev/dri).
FROM python:3.12-slim

ARG ROCM_VERSION=6.4

RUN apt-get update \
    && apt-get install -y --no-install-recommends libnuma1 libelf1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Install PyTorch first (large layer, rarely changes), then the app.
RUN uv pip install --system --no-cache \
    --index-url https://download.pytorch.org/whl/rocm${ROCM_VERSION} torch

# rclone uploads finished transcripts (see --upload-to)
COPY --from=rclone/rclone:latest /usr/local/bin/rclone /usr/local/bin/rclone

WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN uv pip install --system --no-cache ".[gpu]"

# RX 7600 is gfx1102 (RDNA3). Prebuilt kernels target gfx1100, which is binary compatible.
ENV HSA_OVERRIDE_GFX_VERSION=11.0.0 \
    HF_HOME=/cache/hf \
    RCLONE_CONFIG=/config/rclone/rclone.conf

WORKDIR /data
ENTRYPOINT ["stt"]
CMD ["--help"]
