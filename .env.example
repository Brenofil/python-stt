# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# Hugging Face access token, used when downloading Whisper models.
# Create one at https://huggingface.co/settings/tokens (a read token is enough).
HF_TOKEN=

# Optional: path (on the host) of the list file used with `--input-file /data/urls.txt`.
# Can live outside the repository. Defaults to ./urls.txt.
# URLS_FILE=/home/you/private/urls.txt

# Optional: upload each HTML report right after it is generated (needs rclone, see README).
# STT_UPLOAD_TO=gdrive:stt-transcripts
# Host folder with rclone.conf, mounted into the container. Defaults to ./rclone-config.
# RCLONE_CONFIG_DIR=/home/you/.config/rclone
# With rclone's root_folder_id pointing at the target Drive folder, "gdrive:" is that folder:
# STT_UPLOAD_TO=gdrive:

STT_BATCH_SIZE=2
