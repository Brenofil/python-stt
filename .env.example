# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# Hugging Face access token, used when downloading Whisper models.
# Create one at https://huggingface.co/settings/tokens (a read token is enough).
HF_TOKEN=

# Optional: path (on the host) of the list file used with `--input-file /data/urls.txt`.
# Can live outside the repository. Defaults to ./urls.txt.
# URLS_FILE=/home/you/private/urls.txt
